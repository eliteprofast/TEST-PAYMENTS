PORT=3000
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PayPal does not support AED as a checkout currency — this only affects
# manual test mode. Cart checkouts from ElitezShop always charge USD,
# converted from the AED product catalog (see AED_TO_USD_RATE in server.js).
CURRENCY=USD

# Order notification email address (where you receive payment alerts)
ADMIN_EMAIL=your-email@example.com

# Discord webhook URL used to notify the admin of new orders (optional).
# Create one under Server Settings > Integrations > Webhooks in Discord.
DISCORD_WEBHOOK_URL=

# SendGrid API key (get free at https://sendgrid.com - 1000 emails/month free)
# After signup, go to Settings > API Keys > Create API Key
SENDGRID_API_KEY=
